+static int imx415_s_frame_interval(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_frame_interval *fi)
+{
+	struct imx415 *imx415 = to_imx415(sd);
+	const struct imx415_mode *cur = imx415->cur_mode;
+	const struct imx415_mode *best = NULL;
+	u64 requested_fps, best_delta = U64_MAX;
+	s64 h_blank, vblank_def, vblank_min;
+	u64 pixel_rate;
+	u8 lanes = imx415->bus_cfg.bus.mipi_csi2.num_data_lanes;
+	unsigned int i;
+
+	if (!fi->interval.numerator || !fi->interval.denominator)
+		return -EINVAL;
+
+	requested_fps = div_u64((u64)fi->interval.denominator * 1000,
+				fi->interval.numerator);
+
+	mutex_lock(&imx415->mutex);
+	if (imx415->streaming) {
+		mutex_unlock(&imx415->mutex);
+		return -EBUSY;
+	}
+
+	for (i = 0; i < imx415->cfg_num; i++) {
+		const struct imx415_mode *mode = &imx415->supported_modes[i];
+		u64 mode_fps, delta;
+
+		if (mode->width != cur->width || mode->height != cur->height ||
+		    mode->bus_fmt != cur->bus_fmt || mode->hdr_mode != cur->hdr_mode)
+			continue;
+		mode_fps = div_u64((u64)mode->max_fps.denominator * 1000,
+				   mode->max_fps.numerator);
+		delta = mode_fps > requested_fps ? mode_fps - requested_fps :
+			requested_fps - mode_fps;
+		if (delta < best_delta) {
+			best = mode;
+			best_delta = delta;
+		}
+	}
+
+	if (!best) {
+		mutex_unlock(&imx415->mutex);
+		return -EINVAL;
+	}
+
+	/*
+	 * Modes sharing a frame size can use different input clocks.  S_FMT may
+	 * already have powered the subdevice with the clock for the first matching
+	 * (30 fps) mode, so update it before committing the 27 MHz HFR mode.
+	 */
+	if (best->xvclk != cur->xvclk) {
+		int ret = clk_set_rate(imx415->xvclk, best->xvclk);
+
+		if (ret) {
+			dev_err(&imx415->client->dev,
+				"failed to set xvclk for requested frame interval\n");
+			mutex_unlock(&imx415->mutex);
+			return ret;
+		}
+	}
+
+	imx415_change_mode(imx415, best);
+	h_blank = best->hts_def - best->width;
+	__v4l2_ctrl_modify_range(imx415->hblank, h_blank, h_blank, 1, h_blank);
+	vblank_def = best->vts_def - best->height;
+	/* Keep high-rate modes at their requested cadence.  RKAIQ otherwise
+	 * lowers VBLANK to the generic minimum and unintentionally doubles FPS. */
+	vblank_min = vblank_def;
+	__v4l2_ctrl_modify_range(imx415->vblank, vblank_min,
+				 vblank_def, 1, vblank_def);
+	__v4l2_ctrl_s_ctrl(imx415->vblank, vblank_def);
+	__v4l2_ctrl_s_ctrl(imx415->link_freq, best->mipi_freq_idx);
+	pixel_rate = (u32)link_freq_items[best->mipi_freq_idx] /
+		best->bpp * 2 * lanes;
+	__v4l2_ctrl_s_ctrl_int64(imx415->pixel_rate, pixel_rate);
+	fi->interval = best->max_fps;
+
+	mutex_unlock(&imx415->mutex);
+	return 0;
+}
